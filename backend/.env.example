# Database & Cache
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/temead_db
REDIS_URL=redis://localhost:6379/0

# Security Keys
SECRET_KEY=your_secret_key_32_bytes_here
SECRET_ENCRYPTION_KEY=your_fernet_key_here

# AI Provider
GEMINI_API_KEY=your_gemini_api_key_here

# Google Drive & YouTube Data API
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8501

# Meta Platform (Facebook Graph API)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:8501

# TikTok Developer (Content Posting API v2)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:8501

# Streamlit App Port
STREAMLIT_SERVER_PORT=8501
